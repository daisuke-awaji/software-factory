{
  "name": "factory-plan-samples",
  "private": true,
  "type": "module",
  "description": "計画書に載せたコード片を型チェック・テストするための検証用プロジェクト（本番コードではない）",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.infra.json",
    "test": "vitest run",
    "synth": "tsx src/infra/stack.ts"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "3.1163.0",
    "@aws-sdk/client-lambda-microvms": "3.1163.0",
    "@aws/durable-execution-sdk-js": "3.0.0",
    "@hono/zod-openapi": "1.6.3",
    "aws-cdk-lib": "2.275.0",
    "constructs": "10.8.1",
    "hono": "4.13.16",
    "msw": "3.0.4",
    "react": "19.3.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.164",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
